<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            box-sizing: border-box;
        }

        .contenedor {
            display: flex;
            width: 100%;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .subContenedor {
            width: 50%;
            text-align: center;
        }

        body {
            font-family: Arial, sans-serif;
        }

        h1 {
            text-align: center;
            text-decoration: underline;
        }

        h2 {
            text-align: start;
        }

        .contenedorFormulario {
            display: flex;
            width: 100%;
            justify-content: center;
            align-items: center;
        }

        .formulario {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        input {
            width: 100%;
            margin-right: 10px;
            padding: 4px;
            border-radius: 10px;
        }
        button {
            width: 70px;
            padding: 4px;
            border-radius: 10px;
        }
        li {
            margin-top: 20px;
        }
    </style>
</head>

<body>
    {{{body}}}
</body>

</html>