<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            box-sizing: border-box;
        }

        h1 {
            text-align: center;
            text-decoration: underline;
        }

        .products-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            width: 80%;
            margin: auto;
        }

        .product-card {
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        .price {
            font-size: 18px;
            font-weight: bold;
        }

        .btn-detail {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 12px;
            background: #54687e;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        .btn-detail:hover {
            background: #0056b3;
        }

        .product-detail {
            width: 40%;
            margin: auto;
            text-align: center;
        }

        .btn-cart {
            margin-top: 15px;
            padding: 10px 20px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        .btn-cart:hover {
            background: #1f7a33;
        }

        .pagination {
            margin-top: 30px;
            text-align: center;
        }

        .btn-page {
            margin: 10px;
            text-decoration: none;
            padding: 6px 10px;
            border-radius: 6px;
            background: #333;
            color: white;
        }

        .cart-container {
            width: 50%;
            margin: auto;
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #ddd;
            padding: 10px;
        }

        .cart-title {
            font-weight: bold;
        }

        .cart-total {
            margin-top: 20px;
            font-size: 18px;
        }
    </style>
</head>

<body>
    {{{body}}}
</body>

</html>